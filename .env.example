# Application Configuration
APP_NAME="Incident Investigation Agent"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# CORS
ALLOWED_ORIGINS=["*"]

# Relational Database (PostgreSQL)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="incident_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/incident_db"

# Cache & Session Store (Redis)
REDIS_URL="redis://localhost:6379/0"
# Rate limits (login, chat, raw queries) are shared through Redis. Use "memory" for one process only.
RATE_LIMIT_STORE=redis

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="runbooks"
QDRANT_API_KEY=""

# Observability (Prometheus & Grafana Loki)
PROMETHEUS_URL="http://localhost:9090"
LOKI_URL="http://localhost:3100"

# LLM Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Chat agent model: groq (default) or gemini
LLM_PROVIDER=groq
# Groq (OpenAI-hosted and open models; daily token limits apply)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini (Google AI Studio). Free-tier prompts may be used for training; see the console terms.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LangSmith tracing (off by default). Set the key and LANGSMITH_TRACING=true to trace LangGraph runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-agent
